---
import '../styles/index.css';
import Navigation from '../components/Navigation.astro';
import JsonLd from '../components/JsonLd.astro';
import { absoluteImageUrl, absoluteUrl, site } from '../config/site';

type Props = {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: Record<string, unknown>;
};

const { title, description, type = 'website', image, publishedAt, updatedAt, jsonLd } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const socialImage = absoluteImageUrl(image);
const globalJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: `${site.origin}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author.name,
    url: absoluteUrl('/architect/'),
    sameAs: [site.author.github, site.author.linkedin],
  },
];
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <title>{title}</title>
    <JsonLd data={globalJsonLd} />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <Navigation />
    <slot />
  </body>
</html>
