---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const projects = await getCollection('portfolio', ({ data }) => !data.draft);
---

<BaseLayout title="Portfolio | The Construct" description="Selected software architecture and engineering projects.">
  <main class="min-h-screen px-6 pt-28 pb-16">
    <div class="mx-auto max-w-6xl space-y-8">
      <header class="space-y-2">
        <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">Portfolio</p>
        <h1 class="text-3xl">Project Highlights</h1>
        <p class="text-muted-foreground">Selected work, technical decisions, and outcomes.</p>
      </header>
      <section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3" aria-label="Projects">
        {
          projects.map((project) => (
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
              <h2 class="text-lg"><a class="hover:underline" href={`${base}portfolio/${project.id}/`}>{project.data.title}</a></h2>
              <p class="mt-2 text-sm text-muted-foreground">{project.data.summary}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.data.techStack.map((tech) => <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">{tech}</span>)}
              </div>
              <a class="mt-4 inline-flex text-sm font-medium text-primary" href={`${base}portfolio/${project.id}/`}>View details</a>
            </article>
          ))
        }
      </section>
    </div>
  </main>
</BaseLayout>
