---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { absoluteImageUrl, absoluteUrl, site } from '../../config/site';

type Props = {
  project: CollectionEntry<'portfolio'>;
};

export async function getStaticPaths() {
  const projects = await getCollection('portfolio', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as Props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const title = project.data.seoTitle ?? project.data.title;
const canonical = absoluteUrl(`${base}portfolio/${project.id}/`);
const relatedProjects = (await getCollection('portfolio', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== project.id && candidate.data.techStack.some((tech) => project.data.techStack.includes(tech)))
  .slice(0, 3)
  .map((candidate) => ({
    title: candidate.data.title,
    href: `${base}portfolio/${candidate.id}/`,
    description: candidate.data.summary,
  }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: project.data.summary,
  url: canonical,
  image: absoluteImageUrl(project.data.coverImage),
  ...(project.data.updatedAt ? { dateModified: project.data.updatedAt.toISOString() } : {}),
  author: { '@type': 'Person', name: site.author.name },
};
---

<BaseLayout
  title={`${title} | The Construct`}
  description={project.data.summary}
  type="article"
  image={project.data.coverImage}
  updatedAt={project.data.updatedAt}
  jsonLd={jsonLd}
>
  <main class="min-h-screen px-6 pt-28 pb-16">
    <article class="mx-auto max-w-3xl">
      <a class="text-sm text-primary underline underline-offset-4" href={`${base}portfolio/`}>← All projects</a>
      <header class="mt-8 space-y-4">
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">Portfolio</p>
        <h1 class="text-4xl leading-tight">{project.data.title}</h1>
        <p class="text-lg text-muted-foreground">{project.data.summary}</p>
        <div class="flex flex-wrap gap-2">
          {project.data.techStack.map((tech) => <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">{tech}</span>)}
        </div>
      </header>
      <div class="content-prose mt-10"><Content /></div>
      <section class="mt-10 border-t border-border pt-6">
        <h2 class="text-lg">Links</h2>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          {project.data.links.map((link) => <a href={link.href} class="text-primary underline underline-offset-4" target="_blank" rel="noreferrer noopener">{link.label}</a>)}
        </div>
      </section>
      <RelatedContent heading="Related projects" entries={relatedProjects} />
    </article>
  </main>
</BaseLayout>
