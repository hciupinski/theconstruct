---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found | The Construct" description="The requested page could not be found.">
  <main class="min-h-screen px-6 pt-28 pb-16">
    <div class="mx-auto max-w-3xl space-y-4 rounded-lg border border-border bg-card p-6">
      <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">404</p>
      <h1 class="text-3xl">Page not found</h1>
      <p class="text-muted-foreground">The requested page does not exist or is not published.</p>
      <a href={base} class="inline-flex text-sm font-medium text-primary underline underline-offset-4">Return home</a>
    </div>
  </main>
</BaseLayout>
