---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { absoluteImageUrl, absoluteUrl, site } from '../../config/site';
import { tagToSlug } from '../../utils/tags';

type Props = {
  post: CollectionEntry<'blog'>;
};

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(date);
const title = post.data.seoTitle ?? post.data.title;
const canonical = absoluteUrl(`${base}blog/${post.id}/`);
const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== post.id && candidate.data.tags.some((tag) => post.data.tags.includes(tag)))
  .sort((left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf())
  .slice(0, 3)
  .map((candidate) => ({
    title: candidate.data.title,
    href: `${base}blog/${candidate.id}/`,
    description: candidate.data.excerpt,
  }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: post.data.excerpt,
  image: absoluteImageUrl(post.data.coverImage),
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: site.author.name },
};
---

<BaseLayout
  title={`${title} | The Construct`}
  description={post.data.excerpt}
  type="article"
  image={post.data.coverImage}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  jsonLd={jsonLd}
>
  <main class="min-h-screen px-6 pt-28 pb-16">
    <article class="mx-auto max-w-3xl">
      <a class="text-sm text-primary underline underline-offset-4" href={`${base}blog/`}>← All posts</a>
      <header class="mt-8 space-y-4">
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">{formatDate(post.data.publishedAt)}</p>
        <h1 class="text-4xl leading-tight">{post.data.title}</h1>
        <p class="text-lg text-muted-foreground">{post.data.excerpt}</p>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground hover:text-foreground"
              href={`${base}blog/tags/${tagToSlug(tag)}/`}
            >
              {tag}
            </a>
          ))}
        </div>
      </header>
      <div class="content-prose mt-10"><Content /></div>
      <RelatedContent heading="Related articles" entries={relatedPosts} />
    </article>
  </main>
</BaseLayout>
