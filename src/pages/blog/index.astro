---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(date);
---

<BaseLayout title="Blog | The Construct" description="Notes on software architecture, security, and engineering.">
  <main class="min-h-screen px-6 pt-28 pb-16">
    <div class="mx-auto max-w-4xl space-y-8">
      <header class="space-y-2">
        <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">Blog</p>
        <h1 class="text-3xl">Notes and Articles</h1>
        <p class="text-muted-foreground">Published posts from this repository.</p>
      </header>
      <section class="space-y-4" aria-label="Published posts">
        {
          posts.map((post) => (
            <article class="rounded-lg border border-border bg-card p-5">
              <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">
                {formatDate(post.data.publishedAt)}
              </p>
              <h2 class="mt-2 text-xl">
                <a class="hover:underline" href={`${base}blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-sm text-muted-foreground">{post.data.excerpt}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">{tag}</span>)}
              </div>
            </article>
          ))
        }
      </section>
    </div>
  </main>
</BaseLayout>
