---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tagToSlug } from '../../../utils/tags';

type Props = {
  tag: string;
};

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Map<string, string>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      tags.set(tagToSlug(tag), tag);
    }
  }

  return Array.from(tags, ([tag, label]) => ({ params: { tag }, props: { tag: label } }));
}

const { tag } = Astro.props as Props;
const tagSlug = Astro.params.tag ?? tagToSlug(tag);
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.data.tags.some((postTag) => tagToSlug(postTag) === tagSlug))
  .sort((left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(date);
---

<BaseLayout title={`${tag} articles | The Construct`} description={`Engineering notes tagged ${tag}.`}>
  <main class="min-h-screen px-6 pt-28 pb-16">
    <div class="mx-auto max-w-4xl space-y-8">
      <header class="space-y-2">
        <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">Blog tag</p>
        <h1 class="text-3xl">{tag}</h1>
        <p class="text-muted-foreground">Engineering notes tagged {tag}.</p>
      </header>
      <section class="space-y-4" aria-label={`${tag} articles`}>
        {
          posts.map((post) => (
            <article class="rounded-lg border border-border bg-card p-5">
              <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">{formatDate(post.data.publishedAt)}</p>
              <h2 class="mt-2 text-xl">
                <a class="hover:underline" href={`${base}blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-sm text-muted-foreground">{post.data.excerpt}</p>
            </article>
          ))
        }
      </section>
    </div>
  </main>
</BaseLayout>
