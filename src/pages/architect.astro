---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Architect profile | The Construct" description="Architecture profile, experience, and technical highlights.">
  <main class="min-h-screen px-6 pt-28 pb-16">
    <div class="mx-auto max-w-5xl space-y-6">
      <header class="space-y-2">
        <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">Resume</p>
        <h1 class="text-3xl">Architect Profile</h1>
        <p class="text-muted-foreground">This page will host the resume layout and the full architect-focused profile.</p>
      </header>
      <section class="rounded-lg border border-border bg-card p-6 text-sm text-muted-foreground">
        Resume sections: summary, experience, architecture highlights, and certifications.
      </section>
    </div>
  </main>
</BaseLayout>
