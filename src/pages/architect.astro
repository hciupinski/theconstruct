---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectTerminal from '../components/ArchitectTerminal';
---

<BaseLayout title="Architect profile | The Construct" description="Architecture profile, experience, and technical highlights.">
  <main class="min-h-screen px-6 pt-28 pb-2">
    <div class="mx-auto max-w-5xl space-y-6">
      <header class="space-y-2">
        <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">Resume</p>
      </header>
      <ArchitectTerminal client:load />
    </div>
  </main>
</BaseLayout>
