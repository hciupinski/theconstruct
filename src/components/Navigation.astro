---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Home', href: base },
  { label: 'Architect', href: `${base}architect/` },
  { label: 'Portfolio', href: `${base}portfolio/` },
  { label: 'Blog', href: `${base}blog/` },
];
---

<header class="fixed top-0 right-0 left-0 z-10 p-6">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <a href={base} class="text-2xl tracking-tight">The Construct</a>
        <p class="mt-1 text-sm text-gray-600">Software • Architecture • Security</p>
      </div>
      <nav class="flex flex-wrap items-center gap-4 text-sm" aria-label="Main navigation">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={{
                'transition-colors': true,
                'text-foreground': currentPath === item.href,
                'text-muted-foreground': currentPath !== item.href,
              }}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
